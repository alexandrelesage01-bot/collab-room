{
  "name": "ableton-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Produire à plusieurs sur le même Set Ableton Live, en direct, avec une Extension Live et un petit serveur Cloudflare.",
  "scripts": {
    "setup": "sh scripts/setup-sdk.sh",
    "test": "node --test test/sync.test.mjs test/sdk.test.mjs",
    "e2e": "node test/e2e-server.mjs",
    "e2e:window": "node test/e2e-window.mjs",
    "server:dev": "cd server && wrangler dev",
    "server:deploy": "cd server && wrangler deploy",
    "package": "sh extension/package.sh"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.151.2"
  },
  "dependencies": {
    "@ableton-extensions/cli": "file:vendor/ableton-extensions-cli-1.0.0-beta.1.tgz",
    "@ableton-extensions/sdk": "file:vendor/ableton-extensions-sdk-1.0.0-beta.1.tgz",
    "ws": "^8.22.0"
  }
}
